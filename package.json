{
  "name": "career-ops-plugin-commute",
  "version": "0.2.0",
  "description": "career-ops plugin: drive time from home to each posting's workplace",
  "type": "module",
  "license": "MIT",
  "private": true,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "node test/core.test.mjs && node test/smoke.mjs",
    "lint": "eslint . && prettier --check '**/*.mjs' '*.json' 'jsconfig.json'",
    "format": "prettier --write '**/*.mjs' '*.json'",
    "typecheck": "tsc -p jsconfig.json",
    "mutate": "bash scripts/mutate.sh",
    "mutate:all": "stryker run"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@stryker-mutator/core": "10.1.1",
    "@types/node": "18.19.130",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3"
  },
  "overrides": {
    "minimatch": "^11.0.1",
    "qs": "^6.16.1"
  }
}
